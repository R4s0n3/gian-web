# Since the ".env" file is gitignored, you can use the ".env.example" file to
# build a new ".env" file when you clone the repo. Keep this file up-to-date
# when you add new variables to `.env`.

# This file will be committed to version control, so make sure not to have any
# secrets in it. If you are cloning this repo, create a copy of this file named
# ".env" and populate it with your secrets.

# When adding additional environment variables, the schema in "/src/env.js"
# should be updated accordingly.

# Admin authentication
# You can generate a new secret on the command line with:
# npx auth secret
# https://next-auth.js.org/configuration/options#secret
AUTH_SECRET=""
# Comma-, semicolon-, or whitespace-separated. Matching is case-insensitive.
ALLOWED_ADMIN_MAILS=""
# Use a unique password of at least 16 characters. Authentication is disabled while this is empty.
ADMIN_PASSWORD=""

# Prisma
# https://www.prisma.io/docs/reference/database-reference/connection-urls#env
DATABASE_URL="postgresql://postgres:password@localhost:5432/gianweb"

# Canonical public origin used for metadata and Stripe redirects.
# Production builds require a non-local HTTPS origin. The localhost value below
# is for `bun run dev`; override it with the deployed origin for `bun run build`.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# PostHog (optional; the admin overview shows a setup state while incomplete)
# Public project token from Project settings; safe to expose to the browser.
NEXT_PUBLIC_POSTHOG_KEY=""
# EU ingestion: https://eu.i.posthog.com; US ingestion: https://us.i.posthog.com
NEXT_PUBLIC_POSTHOG_HOST="https://eu.i.posthog.com"
# Numeric project ID from the PostHog project URL/settings.
POSTHOG_PROJECT_ID=""
# Server-only personal API key, restricted to this project with query:read scope.
# Never prefix this variable with NEXT_PUBLIC_.
POSTHOG_PERSONAL_API_KEY=""
# EU private API: https://eu.posthog.com; US private API: https://us.posthog.com
POSTHOG_API_HOST="https://eu.posthog.com"

# Stripe (checkout returns a configuration error while these are empty)
STRIPE_SECRET_KEY=""
# Comma- or whitespace-separated ISO country codes. Defaults to Germany.
STRIPE_ALLOWED_SHIPPING_COUNTRIES="DE"

# Cloudflare R2 media (the Media dashboard reports a configuration error while
# any of these are empty; keep the credentials server-side)
# Account-scoped S3 endpoint, for example:
# https://<ACCOUNT_ID>.r2.cloudflarestorage.com
R2_S3_ENDPOINT=""
R2_BUCKET_NAME=""
# Credentials from an R2 API token with Object Read & Write access restricted
# to the media bucket.
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
# Public custom-domain origin for the bucket, for example:
# https://media.example.com
R2_PUBLIC_BASE_URL=""
